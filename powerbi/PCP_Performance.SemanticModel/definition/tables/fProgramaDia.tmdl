	partition fProgramaDia = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaExports & "programa_dia.parquet")),
				    Colunas = Table.SelectColumns(Fonte, {"DATA", "CODIGO_RECURSO", "CODIGO_PRODUTO", "NUMERO_OP", "QTD_PROGRAMADA", "QTD_REAL", "QTD_ADERENTE"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"DATA", type date}, {"CODIGO_RECURSO", type text}, {"CODIGO_PRODUTO", Int64.Type}, {"NUMERO_OP", Int64.Type}, {"QTD_PROGRAMADA", type number}, {"QTD_REAL", type number}, {"QTD_ADERENTE", type number}})
				in
				    Tipos

	annotation PBI_ResultType = Table
