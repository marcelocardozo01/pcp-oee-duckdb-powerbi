table fProgramaDia
	lineageTag: b2c23897-07cd-5e3c-a8c7-5b95ce1739f4

	measure 'Qtd programada' = SUM(fProgramaDia[QTD_PROGRAMADA])
		formatString: #,##0
		lineageTag: 2c1bc759-ad7b-53c5-83ca-d82918116f5c

	measure 'Qtd realizada' = SUM(fProgramaDia[QTD_REAL])
		formatString: #,##0
		lineageTag: e85d4e6a-5af4-5f08-b00e-8111d254cb10

	measure 'Aderência ao volume' = DIVIDE(SUM(fProgramaDia[QTD_REAL]), SUM(fProgramaDia[QTD_PROGRAMADA]))
		formatString: 0.0%
		lineageTag: 7e8739b9-f12c-59ef-ae53-0a59dace7aee

	measure 'Aderência ao mix' = DIVIDE(SUM(fProgramaDia[QTD_ADERENTE]), SUM(fProgramaDia[QTD_PROGRAMADA]))
		formatString: 0.0%
		lineageTag: 27772eaa-b0ae-5c82-894c-172fe5ad1284

