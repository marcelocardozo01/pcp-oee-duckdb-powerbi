	partition fPerdasTempo = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaExports & "an_perdas_tempo.parquet")),
				    Colunas = Table.SelectColumns(Fonte, {"ANO_MES", "CODIGO_RECURSO", "ORDEM", "ETAPA", "TIPO", "HORAS"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"ANO_MES", type text}, {"CODIGO_RECURSO", type text}, {"ORDEM", Int64.Type}, {"ETAPA", type text}, {"TIPO", type text}, {"HORAS", type number}})
