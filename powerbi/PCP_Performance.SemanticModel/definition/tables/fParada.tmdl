table fParada
	lineageTag: 715298fe-532a-5a9d-9f6f-7b296642280b

	measure 'Horas de parada não planejada' = CALCULATE(SUM(fParada[DURACAO_MIN]), fParada[PLANEJADA] = FALSE()) / 60
		formatString: #,##0.0
		lineageTag: af781fed-14e7-58e6-b6f9-58dbf2912227

	measure 'Paradas não planejadas' = CALCULATE(COUNTROWS(fParada), fParada[PLANEJADA] = FALSE())
		formatString: #,##0
		lineageTag: b63018d9-5c05-59ce-8165-57c162a2635d

	column DATA
		dataType: dateTime
		isHidden
		formatString: dd/mm/yyyy
		lineageTag: f94640e0-5bee-565e-8741-c38b61ed66a8
		summarizeBy: none
		sourceColumn: DATA

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column TURNO
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: cd76eee4-3c49-5381-9310-0f9f8d000ae6
