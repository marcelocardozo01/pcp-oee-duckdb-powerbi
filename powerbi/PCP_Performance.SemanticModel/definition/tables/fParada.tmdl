	partition fParada = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaExports & "parada.parquet")),
				    Colunas = Table.SelectColumns(Fonte, {"DATA", "TURNO", "CODIGO_RECURSO", "DURACAO_MIN", "MOTIVO", "CATEGORIA", "PLANEJADA"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"DATA", type date}, {"TURNO", Int64.Type}, {"CODIGO_RECURSO", type text}, {"DURACAO_MIN", type number}, {"MOTIVO", type text}, {"CATEGORIA", type text}, {"PLANEJADA", type logical}})
				in
				    Tipos

	annotation PBI_ResultType = Table
