	partition fPedido = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaExports & "pedido.parquet")),
				    Colunas = Table.SelectColumns(Fonte, {"NUMERO_PEDIDO", "CLIENTE", "CODIGO_PRODUTO", "CODIGO_RECURSO", "QTD_PEDIDA", "QTD_ENTREGUE", "DATA_PROMETIDA", "DATA_ENTREGA", "NO_PRAZO", "COMPLETO", "OTIF", "DIAS_ATRASO"}),
