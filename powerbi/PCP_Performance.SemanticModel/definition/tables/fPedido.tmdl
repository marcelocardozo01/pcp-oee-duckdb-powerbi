table fPedido
	lineageTag: aa1ea766-41a1-5728-945d-f0dacc0136ac

	measure Pedidos = COUNTROWS(fPedido)
		formatString: #,##0
		lineageTag: 39bb980b-b420-50b5-979c-2a36e8e9d25e

	measure 'OTIF %' = DIVIDE(CALCULATE(COUNTROWS(fPedido), fPedido[OTIF] = TRUE()), COUNTROWS(fPedido))
		formatString: 0.0%
		lineageTag: a6982d1b-bb6d-5185-b7f7-b3a56e9e5b87

	measure 'No prazo %' = DIVIDE(CALCULATE(COUNTROWS(fPedido), fPedido[NO_PRAZO] = TRUE()), COUNTROWS(fPedido))
		formatString: 0.0%
		lineageTag: d2c31cab-ed70-5f04-9031-3cc9fef2a9bf

	measure 'Completo %' = DIVIDE(CALCULATE(COUNTROWS(fPedido), fPedido[COMPLETO] = TRUE()), COUNTROWS(fPedido))
		formatString: 0.0%
		lineageTag: 7796a0e7-7324-5b8e-912e-47c247a36388

	measure 'Meta OTIF' = 0.9
		formatString: 0.0%
		lineageTag: b34b837b-fe11-5969-b36c-ea5f0aebd40c

	measure 'Pedidos fora do OTIF' = CALCULATE(COUNTROWS(fPedido), fPedido[OTIF] = FALSE())
		formatString: #,##0
		lineageTag: a911d4f7-280e-59cc-b3fb-b84e4529f807

