	partition fIndicador = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaExports & "an_kpi_mensal.parquet")),
				    Colunas = Table.SelectColumns(Fonte, {"ANO_MES", "ESCOPO", "ORDEM_ESCOPO", "CODIGO", "FAMILIA", "INDICADOR", "UNIDADE", "SENTIDO", "VALOR", "META", "STATUS"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"ANO_MES", type text}, {"ESCOPO", type text}, {"ORDEM_ESCOPO", Int64.Type}, {"CODIGO", type text}, {"FAMILIA", type text}, {"INDICADOR", type text}, {"UNIDADE", type text}, {"SENTIDO", type text}, {"VALOR", type number}, {"META", type number}, {"STATUS", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table
