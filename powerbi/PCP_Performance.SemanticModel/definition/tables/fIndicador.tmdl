table fIndicador
	lineageTag: c51fe5f8-e7cf-5c94-9160-4263bdc028f8

	measure 'Valor do indicador' =
			VAR v = SELECTEDVALUE(fIndicador[VALOR])
			VAR u = SELECTEDVALUE(fIndicador[UNIDADE])
			RETURN
			    IF(ISBLANK(v), BLANK(),
			        SWITCH(u, "%", FORMAT(v, "0.0%"), "R$", FORMAT(v, "R$ #,##0"), "ppm", FORMAT(v, "#,##0"),
			            "un", FORMAT(v, "#,##0"), "item-dia", FORMAT(v, "#,##0"), FORMAT(v, "#,##0.0") & " " & u))
		lineageTag: 55ceab77-73ff-5379-bb30-080a0afcc572

	measure 'Meta do indicador' =
			VAR m = SELECTEDVALUE(fIndicador[META])
			VAR u = SELECTEDVALUE(fIndicador[UNIDADE])
			RETURN
			    IF(ISBLANK(m), "sem meta",
			        SWITCH(u, "%", FORMAT(m, "0.0%"), "ppm", FORMAT(m, "#,##0"), FORMAT(m, "#,##0.0") & " " & u))
		lineageTag: 8643a415-7718-58fb-8cbf-726b60521c47

	measure 'Indicadores no alvo' = CALCULATE(COUNTROWS(fIndicador), fIndicador[STATUS] = "No alvo")
		formatString: #,##0
		lineageTag: 4512351c-4475-57b6-b70f-16e6e445fd12

	measure 'Indicadores críticos' = CALCULATE(COUNTROWS(fIndicador), fIndicador[STATUS] = "Crítico")
		formatString: #,##0
		lineageTag: e2530766-8c0f-5f04-b1e3-9031b569694e

