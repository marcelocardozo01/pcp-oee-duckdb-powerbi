			VAR mx = 1
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;border-radius:12px;padding:13px 16px 10px;box-sizing:border-box;height:290px;overflow:hidden'><div style='font-size:15px;font-weight:600'>OTIF por cliente</div><div style='font-size:12px;color:#A9D3DC;margin:1px 0 10px'>Pedidos entregues no prazo e completos. A marca branca é a meta.</div>"
			    & CONCATENATEX(TOPN(12, t, [@v], DESC), "<div style='display:grid;grid-template-columns:46% 1fr auto;gap:10px;align-items:center;font-size:12px;line-height:1.2;margin-bottom:4px'><div style='color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & fPedido[CLIENTE] & "</div><div style='position:relative;height:12px;background:#14606F;border-radius:0 4px 4px 0'><div style='height:12px;border-radius:0 4px 4px 0;background:#53D1EC;width:" & FORMAT(INT(MIN(1, DIVIDE([@v], mx)) * 100), "0") & "%'></div><div style='position:absolute;left:90%;top:-3px;width:2px;height:18px;background:#F2F2F2'></div></div><div style='text-align:right;white-space:nowrap;min-width:52px'>" & FORMAT([@v], "0%") & " <span style='color:#6FA9B5;margin-left:6px'>" & FORMAT([Pedidos], "0") & " ped." & "</span>" & "</div></div>", "", [@v], DESC)
			    & "</div>"
		lineageTag: dbb6c9bf-c7af-5d09-8b79-e93941d26b76

	measure 'HTML Pedidos fora do OTIF' =
			VAR t = TOPN(5, FILTER(fPedido, fPedido[OTIF] = FALSE()), fPedido[DIAS_ATRASO], DESC, fPedido[NUMERO_PEDIDO], ASC)
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;border-radius:12px;padding:13px 16px 10px;box-sizing:border-box;height:200px;overflow:hidden'><div style='font-size:15px;font-weight:600'>Pedidos fora do OTIF</div><div style='font-size:12px;color:#A9D3DC;margin:1px 0 10px'>Os mais atrasados do período.</div><div style='display:grid;grid-template-columns:64px 1.3fr 1.5fr 70px 70px 54px 110px;gap:10px;font-size:11.5px;color:#A9D3DC;padding-bottom:5px;border-bottom:1px solid #6FA9B5'><div style='text-align:left'>Pedido</div><div style='text-align:left'>Cliente</div><div style='text-align:left'>Produto</div><div style='text-align:left'>Prometido</div><div style='text-align:left'>Entregue</div><div style='text-align:right'>Atraso</div><div style='text-align:right'>Entregue / pedido</div></div>"
			    & CONCATENATEX(t, "<div style='display:grid;grid-template-columns:64px 1.3fr 1.5fr 70px 70px 54px 110px;gap:10px;font-size:12px;line-height:1.25;padding:3px 0;border-bottom:1px solid #1C6E7E'>" & "<div style='text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & FORMAT(fPedido[NUMERO_PEDIDO], "0") & "</div>" & "<div style='text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & fPedido[CLIENTE] & "</div>" & "<div style='text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & RELATED(dProduto[PRODUTO]) & "</div>" & "<div style='text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & FORMAT(fPedido[DATA_PROMETIDA], "dd/mm") & "</div>" & "<div style='text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & IF(ISBLANK(fPedido[DATA_ENTREGA]), "em aberto", FORMAT(fPedido[DATA_ENTREGA], "dd/mm")) & "</div>" & "<div style='text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & FORMAT(fPedido[DIAS_ATRASO], "0") & " d" & "</div>" & "<div style='text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & FORMAT(DIVIDE(fPedido[QTD_ENTREGUE], fPedido[QTD_PEDIDA]), "0%") & "</div>" & "</div>", "", fPedido[DIAS_ATRASO] * 1000000 - fPedido[NUMERO_PEDIDO] / 1000000, DESC)
			    & "</div>"
		lineageTag: 9b064c73-a737-5bcc-9332-acacc0b43492

	measure 'HTML Cartões Qualidade' =
			VAR v1 = [Refugo %]
			VAR c1 = IF(v1 <= 0.025, "#C5DF16", IF(v1 <= 0.0275, "#F2F2F2", "#FF7A6B"))
			VAR r1 = IF(v1 <= 0.025, "✓ No alvo", IF(v1 <= 0.0275, "! Atenção", "✕ Crítico"))
			VAR w1 = FORMAT(INT(MIN(1, DIVIDE(v1, 0.05)) * 100), "0")
			VAR v2 = [FPY]
			VAR c2 = IF(v2 >= 0.965, "#C5DF16", IF(v2 >= 0.8685, "#F2F2F2", "#FF7A6B"))
			VAR r2 = IF(v2 >= 0.965, "✓ No alvo", IF(v2 >= 0.8685, "! Atenção", "✕ Crítico"))
			VAR w2 = FORMAT(INT(MIN(1, DIVIDE(v2, 1)) * 100), "0")
			VAR v3 = [Qualidade]
			VAR c3 = IF(v3 >= 0.98, "#C5DF16", IF(v3 >= 0.882, "#F2F2F2", "#FF7A6B"))
			VAR r3 = IF(v3 >= 0.98, "✓ No alvo", IF(v3 >= 0.882, "! Atenção", "✕ Crítico"))
			VAR w3 = FORMAT(INT(MIN(1, DIVIDE(v3, 1)) * 100), "0")
			VAR v4 = [Peças refugadas]
			VAR v5 = [Custo do refugo]
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;display:flex;gap:12px'>"
			    & "<div style='flex:1;min-width:0;background:#0A4250;border-radius:12px;padding:11px 14px 9px;box-sizing:border-box;height:112px;border-left:4px solid " & c1 & "'><div style='font-size:12px;color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Refugo</div><div style='font-size:29px;font-weight:600;line-height:1.2'>" & FORMAT(v1, "0.00%") & "</div><div style='height:5px;border-radius:3px;background:#14606F;position:relative;margin:7px 0 8px'><div style='height:5px;border-radius:3px;background:#53D1EC;width:" & w1 & "%'></div><div style='position:absolute;left:50%;top:-3px;width:2px;height:11px;background:#F2F2F2'></div></div><div style='display:flex;justify-content:space-between;font-size:11px;color:#A9D3DC'><span>meta ≤ 2,5%</span><span style='font-weight:600;color:" & c1 & "'>" & r1 & "</span></div></div>"
			    & "<div style='flex:1;min-width:0;background:#0A4250;border-radius:12px;padding:11px 14px 9px;box-sizing:border-box;height:112px;border-left:4px solid " & c2 & "'><div style='font-size:12px;color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>FPY, aprovação de primeira</div><div style='font-size:29px;font-weight:600;line-height:1.2'>" & FORMAT(v2, "0.0%") & "</div><div style='height:5px;border-radius:3px;background:#14606F;position:relative;margin:7px 0 8px'><div style='height:5px;border-radius:3px;background:#53D1EC;width:" & w2 & "%'></div><div style='position:absolute;left:96%;top:-3px;width:2px;height:11px;background:#F2F2F2'></div></div><div style='display:flex;justify-content:space-between;font-size:11px;color:#A9D3DC'><span>meta ≥ 96,5%</span><span style='font-weight:600;color:" & c2 & "'>" & r2 & "</span></div></div>"
			    & "<div style='flex:1;min-width:0;background:#0A4250;border-radius:12px;padding:11px 14px 9px;box-sizing:border-box;height:112px;border-left:4px solid " & c3 & "'><div style='font-size:12px;color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Qualidade (fator do OEE)</div><div style='font-size:29px;font-weight:600;line-height:1.2'>" & FORMAT(v3, "0.0%") & "</div><div style='height:5px;border-radius:3px;background:#14606F;position:relative;margin:7px 0 8px'><div style='height:5px;border-radius:3px;background:#53D1EC;width:" & w3 & "%'></div><div style='position:absolute;left:98%;top:-3px;width:2px;height:11px;background:#F2F2F2'></div></div><div style='display:flex;justify-content:space-between;font-size:11px;color:#A9D3DC'><span>meta ≥ 98%</span><span style='font-weight:600;color:" & c3 & "'>" & r3 & "</span></div></div>"
			    & "<div style='flex:1;min-width:0;background:#0A4250;border-radius:12px;padding:11px 14px 9px;box-sizing:border-box;height:112px;border-left:4px solid #078CA9'><div style='font-size:12px;color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Peças refugadas</div><div style='font-size:29px;font-weight:600;line-height:1.2'>" & FORMAT(v4, "#,##0") & "</div><div style='font-size:11px;color:#A9D3DC;margin-top:17px'>contador da máquina</div></div>"
			    & "<div style='flex:1;min-width:0;background:#0A4250;border-radius:12px;padding:11px 14px 9px;box-sizing:border-box;height:112px;border-left:4px solid #078CA9'><div style='font-size:12px;color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Custo do refugo</div><div style='font-size:29px;font-weight:600;line-height:1.2'>" & "R$ " & FORMAT(v5, "#,##0") & "</div><div style='font-size:11px;color:#A9D3DC;margin-top:17px'>peças refugadas × custo padrão</div></div>"
			    & "</div>"
		lineageTag: 38d48364-a0da-5d21-8641-084e10988061

	measure 'HTML Defeitos' =
			VAR t0 = FILTER(ADDCOLUMNS(VALUES(fRefugoDefeito[DEFEITO]), "@v", [Peças refugadas]), NOT ISBLANK([@v]) && [@v] <> 0)
			VAR tot = SUMX(t0, [@v])
			VAR t = ADDCOLUMNS(t0, "@ac", VAR x = [@v] RETURN DIVIDE(SUMX(FILTER(t0, [@v] >= x), [@v]), tot))
			VAR mx = MAXX(t0, [@v])
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;border-radius:12px;padding:13px 16px 10px;box-sizing:border-box;height:290px;overflow:hidden'><div style='font-size:15px;font-weight:600'>Defeitos que mais refugam</div><div style='font-size:12px;color:#A9D3DC;margin:1px 0 10px'>Peças refugadas por defeito e percentual acumulado.</div>"
			    & CONCATENATEX(TOPN(12, t, [@v], DESC), "<div style='display:grid;grid-template-columns:38% 1fr auto;gap:10px;align-items:center;font-size:12px;line-height:1.2;margin-bottom:4px'><div style='color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & fRefugoDefeito[DEFEITO] & "</div><div style='position:relative;height:12px;background:#14606F;border-radius:0 4px 4px 0'><div style='height:12px;border-radius:0 4px 4px 0;background:#53D1EC;width:" & FORMAT(INT(MIN(1, DIVIDE([@v], mx)) * 100), "0") & "%'></div></div><div style='text-align:right;white-space:nowrap;min-width:52px'>" & FORMAT([@v], "#,##0") & " <span style='color:#6FA9B5;margin-left:6px'>" & FORMAT([@ac], "0%") & "</span>" & "</div></div>", "", [@v], DESC)
			    & "</div>"
		lineageTag: a3dbc51d-967b-50e0-92df-e87d78158d49

	measure 'HTML Refugo por máquina' =
			VAR t0 = FILTER(ADDCOLUMNS(SUMMARIZE(dRecurso, dRecurso[CODIGO_RECURSO], dRecurso[RECURSO]), "@v", [Refugo %]), NOT ISBLANK([@v]) && [@v] <> 0)
			VAR tot = SUMX(t0, [@v])
			VAR t = ADDCOLUMNS(t0, "@ac", VAR x = [@v] RETURN DIVIDE(SUMX(FILTER(t0, [@v] >= x), [@v]), tot))
			VAR mx = 0.06
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;border-radius:12px;padding:13px 16px 10px;box-sizing:border-box;height:290px;overflow:hidden'><div style='font-size:15px;font-weight:600'>Refugo por máquina</div><div style='font-size:12px;color:#A9D3DC;margin:1px 0 10px'>Peças refugadas sobre as produzidas. A marca branca é a meta.</div>"
			    & CONCATENATEX(TOPN(12, t, [@v], DESC), "<div style='display:grid;grid-template-columns:42% 1fr auto;gap:10px;align-items:center;font-size:12px;line-height:1.2;margin-bottom:4px'><div style='color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & dRecurso[CODIGO_RECURSO] & "  " & dRecurso[RECURSO] & "</div><div style='position:relative;height:12px;background:#14606F;border-radius:0 4px 4px 0'><div style='height:12px;border-radius:0 4px 4px 0;background:#53D1EC;width:" & FORMAT(INT(MIN(1, DIVIDE([@v], mx)) * 100), "0") & "%'></div><div style='position:absolute;left:42%;top:-3px;width:2px;height:18px;background:#F2F2F2'></div></div><div style='text-align:right;white-space:nowrap;min-width:52px'>" & FORMAT([@v], "0.00%") & "</div></div>", "", [@v], DESC)
			    & "</div>"
		lineageTag: 81436f30-3b8c-54a5-9b2d-5ce5e8858ac7

	measure 'HTML Refugo por produto' =
			VAR t0 = FILTER(ADDCOLUMNS(VALUES(dProduto[PRODUTO]), "@v", [Custo do refugo por defeito]), NOT ISBLANK([@v]) && [@v] <> 0)
			VAR tot = SUMX(t0, [@v])
			VAR t = ADDCOLUMNS(t0, "@ac", VAR x = [@v] RETURN DIVIDE(SUMX(FILTER(t0, [@v] >= x), [@v]), tot))
			VAR mx = MAXX(t0, [@v])
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;border-radius:12px;padding:13px 16px 10px;box-sizing:border-box;height:200px;overflow:hidden'><div style='font-size:15px;font-weight:600'>Onde o refugo custa mais</div><div style='font-size:12px;color:#A9D3DC;margin:1px 0 10px'>Custo do refugo por produto, em reais.</div>"
			    & CONCATENATEX(TOPN(7, t, [@v], DESC), "<div style='display:grid;grid-template-columns:40% 1fr auto;gap:10px;align-items:center;font-size:12px;line-height:1.2;margin-bottom:4px'><div style='color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & dProduto[PRODUTO] & "</div><div style='position:relative;height:12px;background:#14606F;border-radius:0 4px 4px 0'><div style='height:12px;border-radius:0 4px 4px 0;background:#53D1EC;width:" & FORMAT(INT(MIN(1, DIVIDE([@v], mx)) * 100), "0") & "%'></div></div><div style='text-align:right;white-space:nowrap;min-width:52px'>" & "R$ " & FORMAT([@v], "#,##0") & " <span style='color:#6FA9B5;margin-left:6px'>" & FORMAT([@ac], "0%") & "</span>" & "</div></div>", "", [@v], DESC)
			    & "</div>"
		lineageTag: 5bf63a43-b73e-539c-8f60-034c6a6c4948

	measure 'HTML Indicadores' =
			VAR mes = MAX(fIndicador[ANO_MES])
			VAR esc = IF(HASONEVALUE(fIndicador[ESCOPO]), SELECTEDVALUE(fIndicador[ESCOPO]), "Fábrica")
			VAR t = CALCULATETABLE(fIndicador, fIndicador[ANO_MES] = mes, fIndicador[ESCOPO] = esc)
			VAR alvo = COUNTROWS(FILTER(t, fIndicador[STATUS] = "No alvo"))
			VAR comMeta = COUNTROWS(FILTER(t, fIndicador[STATUS] <> "Sem meta"))
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;border-radius:12px;padding:12px 18px;box-sizing:border-box;height:632px;overflow:hidden'><div style='font-size:15px;font-weight:600'>Indicadores do PCP <span style='font-size:12px;font-weight:400;color:#A9D3DC;margin-left:10px'>" & FORMAT(alvo, "0") & " de " & FORMAT(comMeta, "0") & " indicadores com meta estão no alvo. Sem mês selecionado, vale o mais recente.</span></div><div style='column-count:2;column-gap:32px;margin-top:4px'>"
			    & CONCATENATEX(t, IF(RIGHT(fIndicador[CODIGO], 2) = "01", "<div style='font-size:12.5px;font-weight:600;line-height:1.2;color:#C5DF16;padding:6px 0 2px;border-bottom:1px solid #6FA9B5'>" & fIndicador[FAMILIA] & "</div>", "") & "<div style='display:grid;grid-template-columns:1fr 92px 74px 82px;gap:8px;font-size:12px;line-height:1.2;padding:2px 0;border-bottom:1px solid #1C6E7E;break-inside:avoid'><div style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & fIndicador[INDICADOR] & "</div><div style='text-align:right;font-weight:600;white-space:nowrap'>" & SWITCH(fIndicador[UNIDADE], "%", FORMAT(fIndicador[VALOR], "0.0%"), "R$", "R$ " & FORMAT(fIndicador[VALOR], "#,##0"), "ppm", FORMAT(fIndicador[VALOR], "#,##0"), "un", FORMAT(fIndicador[VALOR], "#,##0"), "item-dia", FORMAT(fIndicador[VALOR], "#,##0"), FORMAT(fIndicador[VALOR], "#,##0.0") & " " & fIndicador[UNIDADE]) & "</div><div style='text-align:right;color:#A9D3DC;white-space:nowrap'>" & IF(ISBLANK(fIndicador[META]), "–", SWITCH(fIndicador[SENTIDO], "maior", "≥ ", "menor", "≤ ", "± ") & SWITCH(fIndicador[UNIDADE], "%", FORMAT(fIndicador[META], "0.0%"), "ppm", FORMAT(fIndicador[META], "#,##0"), FORMAT(fIndicador[META], "#,##0.0"))) & "</div><div style='white-space:nowrap;color:" & SWITCH(fIndicador[STATUS], "No alvo", "#C5DF16", "Atenção", "#F2F2F2", "Crítico", "#FF7A6B", "#6FA9B5") & "'>" & SWITCH(fIndicador[STATUS], "No alvo", "✓", "Atenção", "!", "Crítico", "✕", "–") & " " & fIndicador[STATUS] & "</div></div>", "", fIndicador[CODIGO], ASC)
			    & "</div></div>"
		lineageTag: 5f3e3282-95bb-5fed-8d92-e9382c55f23d

	column Bloco
		dataType: string
		isHidden
		lineageTag: 592d76d3-c195-5337-9d46-53298f3a1b2b
		summarizeBy: none
		sourceColumn: Bloco

		annotation SummarizationSetBy = Automatic

	partition Painel = m
		mode: import
		source =
				let
				    Fonte = #table(type table [Bloco = text], {{"HTML"}})
				in
				    Fonte

	annotation PBI_ResultType = Table
