table Painel
	lineageTag: 65e788f7-0be8-5f99-a1ec-07c833e4b3af

	measure 'HTML Cabeçalho Visão geral' =
			VAR ini = LOOKUPVALUE(dMes[MES_ROTULO], dMes[ANO_MES], MIN(dMes[ANO_MES]))
			VAR fim = LOOKUPVALUE(dMes[MES_ROTULO], dMes[ANO_MES], MAX(dMes[ANO_MES]))
			VAR periodo = IF(ini = fim, ini, ini & " a " & fim)
			VAR escopo = IF(HASONEVALUE(dRecurso[CODIGO_RECURSO]), "máquina " & SELECTEDVALUE(dRecurso[CODIGO_RECURSO]), IF(HASONEVALUE(dRecurso[CELULA]), "célula " & SELECTEDVALUE(dRecurso[CELULA]), "fábrica toda"))
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;height:70px;box-sizing:border-box;position:relative;overflow:hidden'><div style='padding:9px 20px 0'><div style='font-size:12px;color:#C5DF16;letter-spacing:.4px'>Moldara Embalagens</div><div style='font-size:23px;font-weight:600;line-height:1.15'>Performance do PCP<span style='font-size:13px;font-weight:400;color:#A9D3DC;margin-left:12px'>" & periodo & ", " & escopo & "</span></div></div><div style='position:absolute;left:0;right:0;bottom:0;height:5px;background:repeating-linear-gradient(135deg,#C5DF16 0 14px,#0A4250 14px 28px)'></div></div>"
		lineageTag: 9d305369-6130-58a0-b27e-9af3b4736587

	measure 'HTML Cabeçalho OEE' =
			VAR ini = LOOKUPVALUE(dMes[MES_ROTULO], dMes[ANO_MES], MIN(dMes[ANO_MES]))
			VAR fim = LOOKUPVALUE(dMes[MES_ROTULO], dMes[ANO_MES], MAX(dMes[ANO_MES]))
			VAR periodo = IF(ini = fim, ini, ini & " a " & fim)
			VAR escopo = IF(HASONEVALUE(dRecurso[CODIGO_RECURSO]), "máquina " & SELECTEDVALUE(dRecurso[CODIGO_RECURSO]), IF(HASONEVALUE(dRecurso[CELULA]), "célula " & SELECTEDVALUE(dRecurso[CELULA]), "fábrica toda"))
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;height:70px;box-sizing:border-box;position:relative;overflow:hidden'><div style='padding:9px 20px 0'><div style='font-size:12px;color:#C5DF16;letter-spacing:.4px'>Moldara Embalagens</div><div style='font-size:23px;font-weight:600;line-height:1.15'>OEE e paradas<span style='font-size:13px;font-weight:400;color:#A9D3DC;margin-left:12px'>" & periodo & ", " & escopo & "</span></div></div><div style='position:absolute;left:0;right:0;bottom:0;height:5px;background:repeating-linear-gradient(135deg,#C5DF16 0 14px,#0A4250 14px 28px)'></div></div>"
		lineageTag: f14d73d0-e640-547e-b1d5-4899889e986c

	measure 'HTML Cabeçalho Programa' =
			VAR ini = LOOKUPVALUE(dMes[MES_ROTULO], dMes[ANO_MES], MIN(dMes[ANO_MES]))
			VAR fim = LOOKUPVALUE(dMes[MES_ROTULO], dMes[ANO_MES], MAX(dMes[ANO_MES]))
			VAR periodo = IF(ini = fim, ini, ini & " a " & fim)
			VAR escopo = IF(HASONEVALUE(dRecurso[CODIGO_RECURSO]), "máquina " & SELECTEDVALUE(dRecurso[CODIGO_RECURSO]), IF(HASONEVALUE(dRecurso[CELULA]), "célula " & SELECTEDVALUE(dRecurso[CELULA]), "fábrica toda"))
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;height:70px;box-sizing:border-box;position:relative;overflow:hidden'><div style='padding:9px 20px 0'><div style='font-size:12px;color:#C5DF16;letter-spacing:.4px'>Moldara Embalagens</div><div style='font-size:23px;font-weight:600;line-height:1.15'>Programa e entrega<span style='font-size:13px;font-weight:400;color:#A9D3DC;margin-left:12px'>" & periodo & ", " & escopo & "</span></div></div><div style='position:absolute;left:0;right:0;bottom:0;height:5px;background:repeating-linear-gradient(135deg,#C5DF16 0 14px,#0A4250 14px 28px)'></div></div>"
		lineageTag: 58f07614-7a58-5d7c-a004-79c30b44423c

	measure 'HTML Cabeçalho Qualidade' =
			VAR ini = LOOKUPVALUE(dMes[MES_ROTULO], dMes[ANO_MES], MIN(dMes[ANO_MES]))
			VAR fim = LOOKUPVALUE(dMes[MES_ROTULO], dMes[ANO_MES], MAX(dMes[ANO_MES]))
			VAR periodo = IF(ini = fim, ini, ini & " a " & fim)
			VAR escopo = IF(HASONEVALUE(dRecurso[CODIGO_RECURSO]), "máquina " & SELECTEDVALUE(dRecurso[CODIGO_RECURSO]), IF(HASONEVALUE(dRecurso[CELULA]), "célula " & SELECTEDVALUE(dRecurso[CELULA]), "fábrica toda"))
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;height:70px;box-sizing:border-box;position:relative;overflow:hidden'><div style='padding:9px 20px 0'><div style='font-size:12px;color:#C5DF16;letter-spacing:.4px'>Moldara Embalagens</div><div style='font-size:23px;font-weight:600;line-height:1.15'>Qualidade<span style='font-size:13px;font-weight:400;color:#A9D3DC;margin-left:12px'>" & periodo & ", " & escopo & "</span></div></div><div style='position:absolute;left:0;right:0;bottom:0;height:5px;background:repeating-linear-gradient(135deg,#C5DF16 0 14px,#0A4250 14px 28px)'></div></div>"
		lineageTag: 9edfa822-6a61-5c54-88eb-8a302b9db5bb

	measure 'HTML Cabeçalho Indicadores' =
			VAR ini = LOOKUPVALUE(dMes[MES_ROTULO], dMes[ANO_MES], MIN(dMes[ANO_MES]))
			VAR fim = LOOKUPVALUE(dMes[MES_ROTULO], dMes[ANO_MES], MAX(dMes[ANO_MES]))
			VAR periodo = fim
			VAR escopo = IF(HASONEVALUE(fIndicador[ESCOPO]), SELECTEDVALUE(fIndicador[ESCOPO]), "Fábrica")
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;height:70px;box-sizing:border-box;position:relative;overflow:hidden'><div style='padding:9px 20px 0'><div style='font-size:12px;color:#C5DF16;letter-spacing:.4px'>Moldara Embalagens</div><div style='font-size:23px;font-weight:600;line-height:1.15'>Todos os indicadores<span style='font-size:13px;font-weight:400;color:#A9D3DC;margin-left:12px'>" & periodo & ", " & escopo & "</span></div></div><div style='position:absolute;left:0;right:0;bottom:0;height:5px;background:repeating-linear-gradient(135deg,#C5DF16 0 14px,#0A4250 14px 28px)'></div></div>"
		lineageTag: 679a20c3-9d01-5e9b-9e4d-a88a621032f5

	measure 'HTML Cartões Visão geral' =
			VAR v1 = [OEE]
			VAR c1 = IF(v1 >= 0.75, "#C5DF16", IF(v1 >= 0.675, "#F2F2F2", "#FF7A6B"))
			VAR r1 = IF(v1 >= 0.75, "✓ No alvo", IF(v1 >= 0.675, "! Atenção", "✕ Crítico"))
			VAR w1 = FORMAT(INT(MIN(1, DIVIDE(v1, 1)) * 100), "0")
			VAR v2 = [Aderência ao mix]
			VAR c2 = IF(v2 >= 0.9, "#C5DF16", IF(v2 >= 0.81, "#F2F2F2", "#FF7A6B"))
			VAR r2 = IF(v2 >= 0.9, "✓ No alvo", IF(v2 >= 0.81, "! Atenção", "✕ Crítico"))
			VAR w2 = FORMAT(INT(MIN(1, DIVIDE(v2, 1)) * 100), "0")
			VAR v3 = [OTIF %]
			VAR c3 = IF(v3 >= 0.9, "#C5DF16", IF(v3 >= 0.81, "#F2F2F2", "#FF7A6B"))
			VAR r3 = IF(v3 >= 0.9, "✓ No alvo", IF(v3 >= 0.81, "! Atenção", "✕ Crítico"))
			VAR w3 = FORMAT(INT(MIN(1, DIVIDE(v3, 1)) * 100), "0")
			VAR v4 = [Refugo %]
			VAR c4 = IF(v4 <= 0.025, "#C5DF16", IF(v4 <= 0.0275, "#F2F2F2", "#FF7A6B"))
			VAR r4 = IF(v4 <= 0.025, "✓ No alvo", IF(v4 <= 0.0275, "! Atenção", "✕ Crítico"))
			VAR w4 = FORMAT(INT(MIN(1, DIVIDE(v4, 0.05)) * 100), "0")
			VAR v5 = [Parada não planejada %]
			VAR c5 = IF(v5 <= 0.15, "#C5DF16", IF(v5 <= 0.165, "#F2F2F2", "#FF7A6B"))
			VAR r5 = IF(v5 <= 0.15, "✓ No alvo", IF(v5 <= 0.165, "! Atenção", "✕ Crítico"))
			VAR w5 = FORMAT(INT(MIN(1, DIVIDE(v5, 0.3)) * 100), "0")
			VAR v6 = [MTBF (h)]
			VAR c6 = IF(v6 >= 16, "#C5DF16", IF(v6 >= 14.4, "#F2F2F2", "#FF7A6B"))
			VAR r6 = IF(v6 >= 16, "✓ No alvo", IF(v6 >= 14.4, "! Atenção", "✕ Crítico"))
			VAR w6 = FORMAT(INT(MIN(1, DIVIDE(v6, 21.3)) * 100), "0")
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;display:flex;gap:12px'>"
			    & "<div style='flex:1;min-width:0;background:#0A4250;border-radius:12px;padding:11px 14px 9px;box-sizing:border-box;height:112px;border-left:4px solid " & c1 & "'><div style='font-size:12px;color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>OEE</div><div style='font-size:29px;font-weight:600;line-height:1.2'>" & FORMAT(v1, "0.0%") & "</div><div style='height:5px;border-radius:3px;background:#14606F;position:relative;margin:7px 0 8px'><div style='height:5px;border-radius:3px;background:#53D1EC;width:" & w1 & "%'></div><div style='position:absolute;left:75%;top:-3px;width:2px;height:11px;background:#F2F2F2'></div></div><div style='display:flex;justify-content:space-between;font-size:11px;color:#A9D3DC'><span>meta ≥ 75%</span><span style='font-weight:600;color:" & c1 & "'>" & r1 & "</span></div></div>"
			    & "<div style='flex:1;min-width:0;background:#0A4250;border-radius:12px;padding:11px 14px 9px;box-sizing:border-box;height:112px;border-left:4px solid " & c2 & "'><div style='font-size:12px;color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Aderência ao mix</div><div style='font-size:29px;font-weight:600;line-height:1.2'>" & FORMAT(v2, "0.0%") & "</div><div style='height:5px;border-radius:3px;background:#14606F;position:relative;margin:7px 0 8px'><div style='height:5px;border-radius:3px;background:#53D1EC;width:" & w2 & "%'></div><div style='position:absolute;left:90%;top:-3px;width:2px;height:11px;background:#F2F2F2'></div></div><div style='display:flex;justify-content:space-between;font-size:11px;color:#A9D3DC'><span>meta ≥ 90%</span><span style='font-weight:600;color:" & c2 & "'>" & r2 & "</span></div></div>"
			    & "<div style='flex:1;min-width:0;background:#0A4250;border-radius:12px;padding:11px 14px 9px;box-sizing:border-box;height:112px;border-left:4px solid " & c3 & "'><div style='font-size:12px;color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>OTIF</div><div style='font-size:29px;font-weight:600;line-height:1.2'>" & FORMAT(v3, "0.0%") & "</div><div style='height:5px;border-radius:3px;background:#14606F;position:relative;margin:7px 0 8px'><div style='height:5px;border-radius:3px;background:#53D1EC;width:" & w3 & "%'></div><div style='position:absolute;left:90%;top:-3px;width:2px;height:11px;background:#F2F2F2'></div></div><div style='display:flex;justify-content:space-between;font-size:11px;color:#A9D3DC'><span>meta ≥ 90%</span><span style='font-weight:600;color:" & c3 & "'>" & r3 & "</span></div></div>"
			    & "<div style='flex:1;min-width:0;background:#0A4250;border-radius:12px;padding:11px 14px 9px;box-sizing:border-box;height:112px;border-left:4px solid " & c4 & "'><div style='font-size:12px;color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Refugo</div><div style='font-size:29px;font-weight:600;line-height:1.2'>" & FORMAT(v4, "0.00%") & "</div><div style='height:5px;border-radius:3px;background:#14606F;position:relative;margin:7px 0 8px'><div style='height:5px;border-radius:3px;background:#53D1EC;width:" & w4 & "%'></div><div style='position:absolute;left:50%;top:-3px;width:2px;height:11px;background:#F2F2F2'></div></div><div style='display:flex;justify-content:space-between;font-size:11px;color:#A9D3DC'><span>meta ≤ 2,5%</span><span style='font-weight:600;color:" & c4 & "'>" & r4 & "</span></div></div>"
			    & "<div style='flex:1;min-width:0;background:#0A4250;border-radius:12px;padding:11px 14px 9px;box-sizing:border-box;height:112px;border-left:4px solid " & c5 & "'><div style='font-size:12px;color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Parada não planejada</div><div style='font-size:29px;font-weight:600;line-height:1.2'>" & FORMAT(v5, "0.0%") & "</div><div style='height:5px;border-radius:3px;background:#14606F;position:relative;margin:7px 0 8px'><div style='height:5px;border-radius:3px;background:#53D1EC;width:" & w5 & "%'></div><div style='position:absolute;left:50%;top:-3px;width:2px;height:11px;background:#F2F2F2'></div></div><div style='display:flex;justify-content:space-between;font-size:11px;color:#A9D3DC'><span>meta ≤ 15%</span><span style='font-weight:600;color:" & c5 & "'>" & r5 & "</span></div></div>"
			    & "<div style='flex:1;min-width:0;background:#0A4250;border-radius:12px;padding:11px 14px 9px;box-sizing:border-box;height:112px;border-left:4px solid " & c6 & "'><div style='font-size:12px;color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>MTBF</div><div style='font-size:29px;font-weight:600;line-height:1.2'>" & FORMAT(v6, "#,##0.0") & " h" & "</div><div style='height:5px;border-radius:3px;background:#14606F;position:relative;margin:7px 0 8px'><div style='height:5px;border-radius:3px;background:#53D1EC;width:" & w6 & "%'></div><div style='position:absolute;left:75%;top:-3px;width:2px;height:11px;background:#F2F2F2'></div></div><div style='display:flex;justify-content:space-between;font-size:11px;color:#A9D3DC'><span>meta ≥ 16 h</span><span style='font-weight:600;color:" & c6 & "'>" & r6 & "</span></div></div>"
			    & "</div>"
		lineageTag: 229ed892-cfff-54fc-a395-6b6d5e415395

	measure 'HTML Cascata' =
			VAR t = FILTER(ADDCOLUMNS(SUMMARIZE(fPerdasTempo, fPerdasTempo[ORDEM], fPerdasTempo[ETAPA], fPerdasTempo[TIPO]), "@h", [Horas de calendário]), [@h] >= 1)
			VAR tot = SUMX(t, [@h])
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;border-radius:12px;padding:13px 16px 10px;box-sizing:border-box;height:126px;overflow:hidden'><div style='font-size:15px;font-weight:600'>Para onde foram as horas das máquinas</div><div style='font-size:12px;color:#A9D3DC;margin:1px 0 10px'>As 24 horas de calendário de cada máquina: o que virou peça boa e o que se perdeu no caminho.</div><div style='display:flex;gap:2px;height:30px;margin-bottom:11px'>"
			    & CONCATENATEX(t, "<div style='flex:" & FORMAT(INT([@h]), "0") & " 0 0;min-width:3px;border-radius:4px;font-size:12px;font-weight:600;padding:6px 7px;white-space:nowrap;overflow:hidden;box-sizing:border-box;background:" & SWITCH(fPerdasTempo[TIPO], "Produtivo", "#53D1EC", "Disponibilidade", "#C5DF16", "Performance", "#DDF156", "Qualidade", "#F2F2F2", "#2B7585") & ";color:" & IF(fPerdasTempo[TIPO] = "Fora da carga", "#F2F2F2", "#0A4250") & "'>" & IF(DIVIDE([@h], tot) > 0.06, FORMAT(DIVIDE([@h], tot), "0%"), "") & "</div>", "", SWITCH(fPerdasTempo[ORDEM], 9, 1, 8, 2, 7, 3, 3, 4, 4, 5, 5, 6, 6, 7, 2, 8, 9), ASC)
			    & "</div><div style='display:flex;flex-wrap:wrap;gap:5px 18px;font-size:12px;color:#A9D3DC'>"
			    & CONCATENATEX(t, "<span style='white-space:nowrap'><i style='display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:6px;background:" & SWITCH(fPerdasTempo[TIPO], "Produtivo", "#53D1EC", "Disponibilidade", "#C5DF16", "Performance", "#DDF156", "Qualidade", "#F2F2F2", "#2B7585") & "'></i>" & fPerdasTempo[ETAPA] & " <b style='color:#F2F2F2;font-weight:600'>" & FORMAT([@h], "#,##0") & " h" & "</b></span>", "", SWITCH(fPerdasTempo[ORDEM], 9, 1, 8, 2, 7, 3, 3, 4, 4, 5, 5, 6, 6, 7, 2, 8, 9), ASC)
			    & "</div></div>"
		lineageTag: 3e86ed7a-2276-59d7-8406-b44586cef5ab

	measure 'HTML Máquinas' =
			VAR t = FILTER(ADDCOLUMNS(SUMMARIZE(dRecurso, dRecurso[CODIGO_RECURSO], dRecurso[RECURSO]), "@o", [OEE], "@d", [Disponibilidade], "@p", [Performance], "@q", [Qualidade]), NOT ISBLANK([@o]))
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;border-radius:12px;padding:13px 16px 10px;box-sizing:border-box;height:352px;overflow:hidden'><div style='font-size:15px;font-weight:600'>Máquinas</div><div style='font-size:12px;color:#A9D3DC;margin:1px 0 10px'>OEE de cada máquina contra a meta de 75%, com disponibilidade (D), performance (P) e qualidade (Q).</div><div style='display:grid;grid-template-columns:repeat(4,1fr);gap:8px'>"
			    & CONCATENATEX(t, "<div style='background:#0F5160;border-radius:8px;padding:8px 10px 9px;border-top:3px solid " & IF([@o] >= 0.75, "#C5DF16", IF([@o] >= 0.675, "#F2F2F2", "#FF7A6B")) & "'><div style='display:flex;justify-content:space-between;align-items:baseline'><b style='font-size:13px;font-weight:600'>" & dRecurso[CODIGO_RECURSO] & "</b><span style='font-size:19px;font-weight:600'>" & FORMAT([@o], "0.0%") & "</span></div><div style='font-size:10.5px;color:#6FA9B5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & dRecurso[RECURSO] & "</div><div style='height:5px;border-radius:3px;background:#14606F;position:relative;margin:6px 0 6px'><div style='height:5px;border-radius:3px;background:#53D1EC;width:" & FORMAT(INT(MIN(1, [@o]) * 100), "0") & "%'></div><div style='position:absolute;left:75%;top:-3px;width:2px;height:11px;background:#F2F2F2'></div></div><div style='display:flex;justify-content:space-between;font-size:10.5px;color:#A9D3DC'>" & "<span>D <b style='color:#F2F2F2;font-weight:600'>" & FORMAT([@d], "0%") & "</b></span>" & "<span>P <b style='color:#F2F2F2;font-weight:600'>" & FORMAT([@p], "0%") & "</b></span>" & "<span>Q <b style='color:#F2F2F2;font-weight:600'>" & FORMAT([@q], "0%") & "</b></span>" & "</div></div>", "", dRecurso[CODIGO_RECURSO], ASC)
			    & "</div></div>"
		lineageTag: 22d0d840-70a4-5cf1-a5c4-a932325f92c7

	measure 'HTML Cartões OEE' =
			VAR v1 = [OEE]
			VAR c1 = IF(v1 >= 0.75, "#C5DF16", IF(v1 >= 0.675, "#F2F2F2", "#FF7A6B"))
			VAR r1 = IF(v1 >= 0.75, "✓ No alvo", IF(v1 >= 0.675, "! Atenção", "✕ Crítico"))
			VAR w1 = FORMAT(INT(MIN(1, DIVIDE(v1, 1)) * 100), "0")
			VAR v2 = [Disponibilidade]
			VAR c2 = IF(v2 >= 0.85, "#C5DF16", IF(v2 >= 0.765, "#F2F2F2", "#FF7A6B"))
			VAR r2 = IF(v2 >= 0.85, "✓ No alvo", IF(v2 >= 0.765, "! Atenção", "✕ Crítico"))
			VAR w2 = FORMAT(INT(MIN(1, DIVIDE(v2, 1)) * 100), "0")
			VAR v3 = [Performance]
			VAR c3 = IF(v3 >= 0.92, "#C5DF16", IF(v3 >= 0.828, "#F2F2F2", "#FF7A6B"))
			VAR r3 = IF(v3 >= 0.92, "✓ No alvo", IF(v3 >= 0.828, "! Atenção", "✕ Crítico"))
			VAR w3 = FORMAT(INT(MIN(1, DIVIDE(v3, 1)) * 100), "0")
			VAR v4 = [Qualidade]
			VAR c4 = IF(v4 >= 0.98, "#C5DF16", IF(v4 >= 0.882, "#F2F2F2", "#FF7A6B"))
			VAR r4 = IF(v4 >= 0.98, "✓ No alvo", IF(v4 >= 0.882, "! Atenção", "✕ Crítico"))
			VAR w4 = FORMAT(INT(MIN(1, DIVIDE(v4, 1)) * 100), "0")
			VAR v5 = [MTTR (min)]
			VAR c5 = IF(v5 <= 55, "#C5DF16", IF(v5 <= 60.5, "#F2F2F2", "#FF7A6B"))
			VAR r5 = IF(v5 <= 55, "✓ No alvo", IF(v5 <= 60.5, "! Atenção", "✕ Crítico"))
			VAR w5 = FORMAT(INT(MIN(1, DIVIDE(v5, 110)) * 100), "0")
			VAR v6 = [Custo das paradas]
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;display:flex;gap:12px'>"
