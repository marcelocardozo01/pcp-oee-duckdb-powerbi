	measure 'HTML OEE por máquina' =
			VAR t0 = FILTER(ADDCOLUMNS(SUMMARIZE(dRecurso, dRecurso[CODIGO_RECURSO], dRecurso[RECURSO]), "@v", [OEE]), NOT ISBLANK([@v]) && [@v] <> 0)
			VAR tot = SUMX(t0, [@v])
			VAR t = ADDCOLUMNS(t0, "@ac", VAR x = [@v] RETURN DIVIDE(SUMX(FILTER(t0, [@v] >= x), [@v]), tot))
			VAR mx = 1
			RETURN
			    "<div style='font-family:Bahnschrift,Segoe UI,sans-serif;color:#F2F2F2;line-height:1.35;background:#0A4250;border-radius:12px;padding:13px 16px 10px;box-sizing:border-box;height:290px;overflow:hidden'><div style='font-size:15px;font-weight:600'>OEE por máquina</div><div style='font-size:12px;color:#A9D3DC;margin:1px 0 10px'>Da melhor para a pior no período. A marca branca é a meta.</div>"
			    & CONCATENATEX(TOPN(12, t, [@v], DESC), "<div style='display:grid;grid-template-columns:42% 1fr auto;gap:10px;align-items:center;font-size:12px;line-height:1.2;margin-bottom:4px'><div style='color:#A9D3DC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & dRecurso[CODIGO_RECURSO] & "  " & dRecurso[RECURSO] & "</div><div style='position:relative;height:12px;background:#14606F;border-radius:0 4px 4px 0'><div style='height:12px;border-radius:0 4px 4px 0;background:#53D1EC;width:" & FORMAT(INT(MIN(1, DIVIDE([@v], mx)) * 100), "0") & "%'></div><div style='position:absolute;left:75%;top:-3px;width:2px;height:18px;background:#F2F2F2'></div></div><div style='text-align:right;white-space:nowrap;min-width:52px'>" & FORMAT([@v], "0.0%") & "</div></div>", "", [@v], DESC)
			    & "</div>"
		lineageTag: addca872-6eeb-55df-a111-dc1c09e343d2

