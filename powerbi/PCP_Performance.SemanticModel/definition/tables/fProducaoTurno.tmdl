table fProducaoTurno
	lineageTag: 9a26c020-ac28-5e16-8669-0028f87f6028

	measure Disponibilidade = DIVIDE(SUM(fProducaoTurno[TEMPO_PRODUZINDO_MIN]), SUM(fProducaoTurno[TEMPO_PROGRAMADO_MIN]))
		formatString: 0.0%
		lineageTag: ef453eed-8285-5ea5-b432-b13520007cd1

	measure Performance = DIVIDE(SUM(fProducaoTurno[TEMPO_TEORICO_MIN]), SUM(fProducaoTurno[TEMPO_PRODUZINDO_MIN]))
		formatString: 0.0%
		lineageTag: 03b2d5f9-f3b6-508b-bd4d-d600812a77a9

	measure Qualidade = DIVIDE(SUM(fProducaoTurno[QTD_BOA]), SUM(fProducaoTurno[QTD_PRODUZIDA]))
		formatString: 0.0%
		lineageTag: 0d80919d-3295-5b40-b2db-a6161b8d107d

	measure OEE = [Disponibilidade] * [Performance] * [Qualidade]
		formatString: 0.0%
		lineageTag: f4e48080-4558-55ff-87dc-1cdf17cf92d2

	measure 'Meta OEE' = 0.75
		formatString: 0.0%
		lineageTag: 303f23fc-89e3-54ed-947c-bd983e218054

	measure 'Peças boas' = SUM(fProducaoTurno[QTD_BOA])
		formatString: #,##0
		lineageTag: 1e338b6b-959b-55f8-8c01-e7278046e874

	measure 'Peças produzidas' = SUM(fProducaoTurno[QTD_PRODUZIDA])
		formatString: #,##0
		lineageTag: 3710da5b-69d9-5254-8f81-914b5c54d9f2

	measure 'Refugo %' = DIVIDE(SUM(fProducaoTurno[QTD_REFUGO]), SUM(fProducaoTurno[QTD_PRODUZIDA]))
		formatString: 0.00%
		lineageTag: 57a6ca5f-b7cb-55e2-8f2b-23f83ad86afb

	measure FPY = DIVIDE(SUM(fProducaoTurno[QTD_BOA]) - SUM(fProducaoTurno[QTD_RETRABALHO]), SUM(fProducaoTurno[QTD_PRODUZIDA]))
		formatString: 0.0%
		lineageTag: 67b997e4-9571-5efb-88a6-caab7d502985

	measure 'Toneladas transformadas' = SUM(fProducaoTurno[KG_TRANSFORMADO]) / 1000
		formatString: #,##0.0
		lineageTag: 6d5f49c6-cf0d-593f-aed7-9c863fbe4412

	measure 'Horas paradas não planejadas' = SUM(fProducaoTurno[PARADA_NAO_PLANEJADA_MIN]) / 60
		formatString: #,##0
		lineageTag: cfa19987-1c78-5648-8096-22734820b9dd

	measure 'Parada não planejada %' = DIVIDE(SUM(fProducaoTurno[PARADA_NAO_PLANEJADA_MIN]), SUM(fProducaoTurno[TEMPO_PROGRAMADO_MIN]))
		formatString: 0.0%
		lineageTag: 6af774c4-71be-517b-8c1e-c4e5dbe211da

	measure 'MTBF (h)' = DIVIDE(SUM(fProducaoTurno[TEMPO_PRODUZINDO_MIN]) / 60, SUM(fProducaoTurno[N_QUEBRAS]))
		formatString: #,##0.0
		lineageTag: 4ccbc237-7045-5a32-a899-cb337d2abd8a

	measure 'MTTR (min)' = DIVIDE(SUM(fProducaoTurno[QUEBRA_MIN]), SUM(fProducaoTurno[N_QUEBRAS]))
		formatString: #,##0.0
		lineageTag: 9b623324-9301-5e7f-9a17-01687781bbd4

	measure Quebras = SUM(fProducaoTurno[N_QUEBRAS])
		formatString: #,##0
		lineageTag: 2a54f68a-2900-5def-bba8-81f631973be5

	measure 'Custo do refugo' = SUM(fProducaoTurno[CUSTO_REFUGO])
		formatString: \R\$ #,##0
		lineageTag: ca32f1f0-2b96-5c7f-9f55-180b46ac4ed6

	measure 'Custo das paradas' = SUM(fProducaoTurno[CUSTO_PARADA])
		formatString: \R\$ #,##0
		lineageTag: acfb12e2-7a89-5f05-b2cf-fbff3564aedd

