	partition fProducaoTurno = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaExports & "producao_turno.parquet")),
				    Colunas = Table.SelectColumns(Fonte, {"DATA", "TURNO", "CODIGO_RECURSO", "TEMPO_TURNO_MIN", "PARADA_PLANEJADA_MIN", "TEMPO_PROGRAMADO_MIN", "PARADA_NAO_PLANEJADA_MIN", "SETUP_MIN", "QUEBRA_MIN", "N_QUEBRAS", "TEMPO_PRODUZINDO_MIN", "TEMPO_NAO_APONTADO_MIN", "TEMPO_TEORICO_MIN", "QTD_PRODUZIDA", "QTD_BOA", "QTD_REFUGO", "QTD_RETRABALHO", "KG_TRANSFORMADO", "CUSTO_REFUGO", "CUSTO_PARADA"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"DATA", type date}, {"TURNO", Int64.Type}, {"CODIGO_RECURSO", type text}, {"TEMPO_TURNO_MIN", type number}, {"PARADA_PLANEJADA_MIN", type number}, {"TEMPO_PROGRAMADO_MIN", type number}, {"PARADA_NAO_PLANEJADA_MIN", type number}, {"SETUP_MIN", type number}, {"QUEBRA_MIN", type number}, {"N_QUEBRAS", Int64.Type}, {"TEMPO_PRODUZINDO_MIN", type number}, {"TEMPO_NAO_APONTADO_MIN", type number}, {"TEMPO_TEORICO_MIN", type number}, {"QTD_PRODUZIDA", type number}, {"QTD_BOA", type number}, {"QTD_REFUGO", type number}, {"QTD_RETRABALHO", type number}, {"KG_TRANSFORMADO", type number}, {"CUSTO_REFUGO", type number}, {"CUSTO_PARADA", type number}})
				in
				    Tipos

	annotation PBI_ResultType = Table
