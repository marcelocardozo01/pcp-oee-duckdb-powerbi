model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaExports", "dCalendario", "dMes", "dRecurso", "dProduto", "dTurno", "fProducaoTurno", "fParada", "fRefugoDefeito", "fProgramaDia", "fPedido", "fPerdasTempo", "fIndicador", "Painel"]

annotation PBI_ProTooling = ["DevMode"]

ref table dCalendario
ref table dMes
ref table dRecurso
ref table dProduto
ref table dTurno
ref table fProducaoTurno
ref table fParada
ref table fRefugoDefeito
ref table fProgramaDia
ref table fPedido
ref table fPerdasTempo
ref table fIndicador
ref table Painel

